{
    "$schema": "http://json.schemastore.org/template",
    "author": "Dmitry Ponomarev",
    "classifications": [
        "Web",
        "Clean Architecture Project",
        "API",
        "Microservice"
    ],
    "identity": "dponomarev.cleanarchitecture.template",
    "name": "Clean Architecture Project",
    "description": "Микросервис с Clean Architecture. Author: Dmitry Ponomarev (ponomarev.dy@yandex.ru, GitHub: @Badunsutra)",
    "shortName": "Capi",
    "sourceName": "Capi",
    "preferNameDirectory": true,
    "tags": {
        "language": "C#",
        "type": "project"
    },
    "symbols": {
        "framework": {
            "type": "parameter",
            "datatype": "choice",
            "description": "Целевая версия .NET для всех проектов сервиса.",
            "defaultValue": "net10.0",
            "replaces": "net10.0",
            "choices": [
                {
                    "choice": "net10.0",
                    "description": ".NET 10 LTS"
                },
                {
                    "choice": "net9.0",
                    "description": ".NET 9 для совместимости с курсом"
                }
            ]
        },
        "extensionsVersion": {
            "type": "generated",
            "generator": "switch",
            "replaces": "10.0.15",
            "parameters": {
                "cases": [
                    {
                        "condition": "(framework == 'net9.0')",
                        "value": "9.0.7"
                    },
                    {
                        "value": "10.0.15"
                    }
                ]
            }
        }
    }
}
